import pandas as pd
import os
import urllib.request
import urllib.error
import time

# Path configuration
INPUT_FILE = "data/screened_papers.csv"
DOWNLOAD_DIR = "data/documents"
REGISTRY_FILE = "data/source_registry.csv"

def download_file(url, save_path, timeout=20):
    """Helper function to download a file using urllib."""
    # Use a specific User-Agent to avoid being blocked
    req = urllib.request.Request(
        url, 
        headers={'User-Agent': 'Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)'}
    )
    
    # We use a proxy handler that forces no proxy, similar to step2
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    
    with opener.open(req, timeout=timeout) as response:
        # Check HTTP status
        if response.status != 200:
            raise urllib.error.HTTPError(url, response.status, "Non-200 status", response.headers, None)
        
        # Get content type (can be None)
        content_type = response.headers.get('Content-Type', '')
        
        # Read the content
        content = response.read()
        
        # Write to file (binary mode for PDF, text mode for XML)
        if 'pdf' in save_path:
            with open(save_path, 'wb') as f:
                f.write(content)
        else:
            with open(save_path, 'w', encoding='utf-8') as f:
                f.write(content.decode('utf-8'))
                
        return content_type

def download_documents():
    if not os.path.exists(INPUT_FILE):
        print(f"Error: Input file {INPUT_FILE} not found. Please run step 3 first.")
        return
        
    os.makedirs(DOWNLOAD_DIR, exist_ok=True)
    df = pd.read_csv(INPUT_FILE)
    
    #Resume logic
    if os.path.exists(REGISTRY_FILE):
        registry_df = pd.read_csv(REGISTRY_FILE)
        completed_ids = set(
            registry_df[registry_df['status'].astype(str).str.startswith('retrieved')]['paper_id'].astype(str)
        )
        print(f"Resuming... Found {len(completed_ids)} papers already downloaded. Skipping them.")
    else:
        registry_df = pd.DataFrame(columns=['paper_id', 'title', 'doi', 'status', 'file_path', 'failure_reason'])
        completed_ids = set()

    total_papers = len(df)
    print(f"Starting download process for {total_papers} papers...")

    for index, row in df.iterrows():
        paper_id = str(row['id'])
        source = str(row['source']) if 'source' in row else 'PMC'
        title = str(row['title'])
        doi = str(row.get('doi', ''))
        
        if paper_id in completed_ids:
            continue
            
        print(f"[{index+1}/{total_papers}] Fetching: {paper_id} - {title[:30]}...")
        
        status = 'access_needed'
        failure_reason = ''
        file_path = ''
        
        #Attempt 1: Download PDF
        pdf_url = f"https://europepmc.org/articles/{paper_id}?pdf=render"
        pdf_path = os.path.join(DOWNLOAD_DIR, f"{paper_id}.pdf")
        
        try:
            content_type = download_file(pdf_url, pdf_path)
            if 'application/pdf' in content_type:
                status = 'retrieved_pdf'
                file_path = pdf_path
                print("  -> Success: PDF downloaded.")
            else:
                raise Exception(f"Server returned {content_type} instead of PDF")
                
        except Exception as e:
            # If PDF fails (e.g., it's actually an HTML error page), delete the bad file
            if os.path.exists(pdf_path):
                os.remove(pdf_path)
                
            #Attempt 2: Fallback to XML
            xml_url = f"https://www.ebi.ac.uk/europepmc/webservices/rest/{source}/{paper_id}/fullTextXML"
            xml_path = os.path.join(DOWNLOAD_DIR, f"{paper_id}.xml")
            
            try:
                content_type = download_file(xml_url, xml_path)
                status = 'retrieved_xml'
                file_path = xml_path
                failure_reason = 'PDF unavailable, downloaded XML fallback'
                print("  -> Success: XML downloaded (PDF failed).")
            except Exception as e2:
                # Complete Failure
                if os.path.exists(xml_path):
                    os.remove(xml_path)
                status = 'access_needed'
                failure_reason = f"PDF and XML unavailable."
                print(f"  -> Failed: Manual access required.")

        #Update Registry
        new_record = pd.DataFrame([{
            'paper_id': paper_id,
            'title': title,
            'doi': doi,
            'status': status,
            'file_path': file_path,
            'failure_reason': failure_reason
        }])
        
        registry_df = pd.concat([registry_df, new_record], ignore_index=True)
        registry_df.to_csv(REGISTRY_FILE, index=False, encoding='utf-8-sig')
        
        time.sleep(1.5)

    print("-" * 30)
    print("Download process completed!")
    print(f"Registry updated at: {REGISTRY_FILE}")
    
    pdf_count = len(registry_df[registry_df['status'] == 'retrieved_pdf'])
    xml_count = len(registry_df[registry_df['status'] == 'retrieved_xml'])
    fail_count = len(registry_df[registry_df['status'] == 'access_needed'])
    print("Summary:")
    print(f" - Successfully retrieved PDF: {pdf_count}")
    print(f" - Successfully retrieved XML: {xml_count}")
    print(f" - Failed (access_needed): {fail_count}")

if __name__ == "__main__":
    download_documents()