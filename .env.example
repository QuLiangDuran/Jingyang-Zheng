# Copy to .env and fill in. Any OpenAI-compatible provider works.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...
LLM_TEMPERATURE=0

# SQLite file
AUDIT_DB_PATH=data/audit.db

# Max output tokens per call (check your model's limit). A cut-off answer is stored and marked parse_error.
LLM_MAX_OUTPUT_TOKENS=16000

# The whole paper is sent in one call; only papers longer than this many characters are split into chunks.
# (SEGMENT_MAX_CHARS from v1 is no longer used.)
MAX_DOC_CHARS=200000
