# Copy to .env and fill in. Any OpenAI-compatible provider works.
# Qwen (tested 2026-11-25 with qwen3.8-flash): LLM_BASE_URL=<your Qwen compatible-mode /v1 endpoint>,
#   LLM_MODEL=qwen3.8-flash, LLM_PDF_INPUT=images, LLM_CACHE_CONTROL=1,
#   LLM_EXTRA_BODY={"enable_thinking": false}
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...
LLM_TEMPERATURE=0

# SQLite file
AUDIT_DB_PATH=data/audit.db

# Max output tokens per call (check your model's limit). A cut-off answer is stored and marked parse_error.
LLM_MAX_OUTPUT_TOKENS=32000
# If an answer is still cut off at the limit, ask the model to continue this many extra times
# (the pieces are joined; token counts of every call are stored in extraction_runs.usage).
LLM_MAX_CONTINUATIONS=2

# The whole paper is sent in one call; only papers longer than this many characters are split into chunks.
# (SEGMENT_MAX_CHARS from v1 is no longer used.)
MAX_DOC_CHARS=200000

# Send the original PDF to the model together with the extracted text, so it can read figures.
#   file_id = upload through the provider's Files API and refer to it by id (OpenAI); deleted after extraction
#   inline  = send the PDF as base64 inside the message (providers without a Files API)
#   images  = render the pages here and send them as images next to the text; by default only
#             pages with a figure or table (LLM_IMAGE_PAGES=figures | all), at LLM_IMAGE_DPI
#             (150; 72 misread chart labels on Qwen, 110 was still correct). Qwen: about 2,100
#             tokens per page at 150 dpi vs about 3,700 for inline
#   off     = text only
# Needs a model that accepts PDF input (not DeepSeek). Default when unset: off.
# Qwen: use inline (its endpoint has no Files API; the model reads the pages as images,
# about 3,700 input tokens per page). Check with `python run.py check` before extracting;
# `run.py add` runs the same check first whenever this is not off.
# Quotes are still taken from the extracted text.
LLM_PDF_INPUT=off
LLM_IMAGE_DPI=150
LLM_IMAGE_PAGES=figures

# 1 = mark the system prompt and the paper (last user block) with cache_control, so continuations of
# a paper, and the next paper's system prompt within ~5 minutes, are billed at the cached price.
# Qwen supports it; hits show up as cached_tokens in `python run.py usage`.
LLM_CACHE_CONTROL=0

# Hidden reasoning ("thinking") is billed as output and filled most of the first 32k-token call
# on our DeepSeek runs. Turn it off or down for extraction; the parameter is provider-specific:
#   OpenAI-style:          LLM_REASONING_EFFORT=low
#   DeepSeek:              LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
#   Qwen:                  LLM_EXTRA_BODY={"enable_thinking": false}
#   other providers:       check the provider's docs
LLM_REASONING_EFFORT=
LLM_EXTRA_BODY=
# 1 = ask for a JSON-only answer (response_format json_object), if the provider supports it
LLM_JSON_MODE=0
